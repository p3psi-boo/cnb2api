# ---- proxy (required) ----
PROXY_KEY=change-me-to-a-long-random-string
CNB_TOKEN=change-me
CNB_REPO_SLUG=your-org/ai-proxy

# ---- Magpie fleet contract (same three values as magpie plugin login) ----
# Blank / omit = EMQX public wss://broker.emqx.io:8084/mqtt (override to use your own)
MQTT_BROKER=wss://broker.emqx.io:8084/mqtt
MQTT_TOPIC=cnb2api/my-fleet/presence
MQTT_PSK=change-me-to-a-long-random-string
MQTT_INSTANCE_ID=ws-home
# Optional broker login
#MQTT_USER=
#MQTT_PASS=
# Override the URI published in the heartbeat (defaults to CNB_VSCODE_PROXY_URI)
#MQTT_ADVERTISE_URI=https://xxxx-9001.cnb.run
#MQTT_HEARTBEAT_MS=20000
# Allow http://127.0.0.1 URIs (tests / local)
#MQTT_ALLOW_LOCAL_URI=1

# ---- optional tuning ----
#PROXY_MODELS=deepseek-v4.1-flash,glm-5.3-flash,kimi-k3
#PROXY_PORT=9001
#PROXY_UPSTREAM_TIMEOUT_MS=15000
#PROXY_IDLE_TIMEOUT_MS=300000
